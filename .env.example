# ===== APPLICATION =====
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ===== DATABASE (Supabase / Postgres) =====
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# CA Supabase pour TLS (évite "self-signed certificate in certificate chain")
# DATABASE_SSL_CA_PATH=certs/supabase-ca.crt
# ou : DATABASE_SSL_CA_PATH=certs/prod-ca-2021.crt
# Debug SSL (aucun secret loggé) : DATABASE_SSL_CA_PATH, resolvedPath, existsSync, caLength, rejectUnauthorized
# LOG_SSL_DEBUG=false

# ===== SECURITY =====
ENCRYPTION_KEY=your-32-byte-hex-key

# ===== AMAZON ADS =====
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxxx
AMAZON_CLIENT_SECRET=your-secret
AMAZON_REDIRECT_URI=https://yourdomain.com/auth/amazon/callback
AMAZON_ADS_API_BASE_URL=https://advertising-api-eu.amazon.com

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=123456789:ABC-xxxxx
TELEGRAM_CHAT_ID=your-chat-id

# ===== FEATURE FLAGS =====
DRY_RUN=true
KILL_SWITCH_ENABLED=false

# ===== N8N (optionnel) =====
# N8N_WEBHOOK_BASE_URL=http://localhost:5678
