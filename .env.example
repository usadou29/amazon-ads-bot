# ============================================
# ENDROMEDE - Configuration Environnement
# ============================================

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (Supabase en prod, local en dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andromed
DATABASE_SSL_CA_PATH=  # Optionnel: chemin vers le certificat CA Supabase

# Security (générer avec: openssl rand -hex 32)
ENCRYPTION_KEY=votre_cle_32_caracteres_hex_ici_changez_moi

# Amazon Ads API
AMAZON_CLIENT_ID=votre_client_id_amazon
AMAZON_CLIENT_SECRET=votre_client_secret_amazon
AMAZON_REDIRECT_URI=http://localhost:3001/auth/amazon/callback
AMAZON_ADS_API_BASE_URL=https://advertising-api-eu.amazon.com

# Redis (pour BullMQ et cache)
REDIS_URL=redis://localhost:6379

# Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature Flags
DRY_RUN=true
KILL_SWITCH_ENABLED=false

# n8n (optionnel)
N8N_WEBHOOK_BASE_URL=

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copier ce fichier: cp .env.example .env
# 2. Remplacer les valeurs par vos propres credentials
# 3. Ne JAMAIS commiter le fichier .env
# ============================================
