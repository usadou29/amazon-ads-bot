{
  "name": "endromede",
  "version": "1.0.0",
  "private": true,
  "description": "ENDROMEDE — Plateforme d'optimisation Amazon Ads pour auteurs KDP",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm run start:prod",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "db:push": "cd backend && npx drizzle-kit push",
    "db:studio": "cd backend && npx drizzle-kit studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
